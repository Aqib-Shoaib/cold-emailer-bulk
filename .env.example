# PostgreSQL container and Prisma CLI
POSTGRES_DB=cold_emailer
POSTGRES_USER=cold_emailer
POSTGRES_PASSWORD=replace-with-a-strong-password
# Host-only access for local Prisma/psql; containers continue using db:5432.
POSTGRES_PORT=6543
DATABASE_URL=postgresql://cold_emailer:replace-with-a-url-encoded-password@db:5432/cold_emailer

# Passed only when running the seed command; never store real values here.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Application
APP_PORT=3000
SESSION_SECRET=replace-with-a-random-secret
SETTINGS_ENCRYPTION_KEY=replace-with-a-random-encryption-key
